<?xml version="1.0" encoding="utf-8"?>
<!--
  T09 (Phase 7, MapUI) — Google Maps SDK for Android API key placeholder.

  DO NOT put a real Google Cloud API key in this file, and do not commit one. The value below
  is an intentional placeholder so the app compiles and the manifest's
  `com.google.android.geo.API_KEY` meta-data has something to reference; with the placeholder in
  place the map surface (MapView/GoogleMap) will initialize but will NOT render actual map
  tiles — it will show a blank/grey map and log an "Authorization failure"/API key error from
  Google Play services. This is expected for this prototype and does not affect any of the
  gps-tracking-prototype acceptance criteria (polyline state + the 5 UI-03 metrics are verified
  independently of tile rendering — see TrackingScreenTest).

  Before the map will actually render tiles, a human developer must:
    1. Create/select a project in Google Cloud Console and enable the "Maps SDK for Android" API.
    2. Create an API key restricted to the app's package name (com.mytracksapp) and SHA-1
       signing certificate.
    3. Replace the placeholder value below with that real key, LOCALLY ONLY.
    4. Never commit the real key to version control.

  See docs/setup/google-maps-api-key.md for full setup instructions and the recommended
  local.properties-based follow-up (not implemented here — this placeholder-in-resource
  approach is sufficient for this prototype, which has no CI/signing pipeline yet).
-->
<resources>
    <string name="google_maps_api_key" translatable="false">YOUR_API_KEY_HERE</string>
</resources>
